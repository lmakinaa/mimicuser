# --- Core ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://mimic:mimic@localhost:5433/mimicuser
REDIS_URL=redis://localhost:6380/0
STORAGE_ROOT=./storage

# Fernet key. Encrypts OAuth tokens at rest AND signs the OAuth state param.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Model --------------------------------------------------------------
DEFAULT_MODEL=claude-opus-5
DEFAULT_ENGINE=claude_agent
EVALUATOR_MODEL=claude-opus-5
MODEL_EFFORT=high

# --- Anthropic OAuth ----------------------------------------------------
CLAUDE_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
OAUTH_CALLBACK_URL=https://platform.claude.com/oauth/code/callback

# Alternative to OAuth. Set exactly one of these paths, never both.
# ANTHROPIC_API_KEY=

# --- Browser ------------------------------------------------------------
BROWSER_HEADLESS=true
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=900

# --- Budgets ------------------------------------------------------------
DEFAULT_MAX_TOOL_CALLS=60
DEFAULT_MAX_WALL_SECONDS=600

# --- Frontend -----------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
